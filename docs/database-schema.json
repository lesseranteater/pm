{
  "version": 1,
  "database": "sqlite",
  "entities": {
    "users": {
      "description": "Authenticated users. The MVP seeds one hardcoded user; the schema supports more.",
      "columns": {
        "id": { "type": "TEXT", "primary_key": true },
        "username": { "type": "TEXT", "required": true, "unique": true },
        "password_hash": { "type": "TEXT", "required": true },
        "created_at": { "type": "TEXT", "required": true }
      }
    },
    "boards": {
      "description": "One board per user.",
      "columns": {
        "id": { "type": "TEXT", "primary_key": true },
        "user_id": { "type": "TEXT", "required": true, "unique": true, "references": "users.id" },
        "name": { "type": "TEXT", "required": true },
        "created_at": { "type": "TEXT", "required": true },
        "updated_at": { "type": "TEXT", "required": true }
      }
    },
    "columns": {
      "description": "The board's five fixed columns, ordered by position.",
      "columns": {
        "id": { "type": "TEXT", "primary_key": true },
        "board_id": { "type": "TEXT", "required": true, "references": "boards.id" },
        "name": { "type": "TEXT", "required": true },
        "position": { "type": "INTEGER", "required": true, "minimum": 0, "unique_with": "board_id" },
        "created_at": { "type": "TEXT", "required": true },
        "updated_at": { "type": "TEXT", "required": true }
      }
    },
    "cards": {
      "description": "Cards belonging to a column, ordered by position.",
      "columns": {
        "id": { "type": "TEXT", "primary_key": true },
        "column_id": { "type": "TEXT", "required": true, "references": "columns.id" },
        "title": { "type": "TEXT", "required": true, "non_empty": true },
        "details": { "type": "TEXT", "required": true, "default": "" },
        "position": { "type": "INTEGER", "required": true, "minimum": 0, "unique_with": "column_id" },
        "created_at": { "type": "TEXT", "required": true },
        "updated_at": { "type": "TEXT", "required": true }
      }
    },
    "sessions": {
      "description": "Server-side sessions for the authentication phase.",
      "columns": {
        "id": { "type": "TEXT", "primary_key": true },
        "user_id": { "type": "TEXT", "required": true, "references": "users.id" },
        "token_hash": { "type": "TEXT", "required": true, "unique": true },
        "expires_at": { "type": "TEXT", "required": true },
        "created_at": { "type": "TEXT", "required": true }
      }
    }
  },
  "constraints": [
    "Foreign keys are enabled for every connection.",
    "Deleting a user deletes their board, columns, cards, and sessions.",
    "Deleting a board deletes its columns and cards.",
    "Deleting a column deletes its cards.",
    "A board has at most one owner board per user.",
    "Column positions are unique within a board.",
    "Card positions are unique within a column."
  ],
  "seed": {
    "username": "user",
    "board_name": "Spring launch",
    "columns": ["Backlog", "Planned", "In progress", "Review", "Done"],
    "card_count": 4
  }
}
